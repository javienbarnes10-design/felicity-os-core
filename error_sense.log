    target=$(echo "$text" | sed -E 's/^(cat|less|more)[[:space:]]+//' | xargs)
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] READ: $target" >> "$LOG_FILE"
    if [ -f "$target" ]; then
