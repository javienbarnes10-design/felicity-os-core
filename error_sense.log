import os
import hashlib

def count_functions():
    lines = 0
    functions = 0
    with open(__file__, 'r') as f:
        for line in f:
            lines += 1
            if line.startswith('def '):
                functions += 1
    return lines, functions

def sha256_hash_file(filename):
    hasher = hashlib.sha256()
    with open(filename, 'rb') as f:
        while chunk := f.read(8192):
            hasher.update(chunk)
    return hasher.hexdigest()

if __name__ == '__main__':
    lines, functions = count_functions()
    hash_value = sha256_hash_file(__file__)
    
    metrics = {
        "lines": lines,
        "functions": functions,
        "sha256": hash_value
    }
    
    with open('self_metrics.json', 'w') as f:
        import json
        json.dump(metrics, f)
EOF
