run_fetch() {
    local text="$1"
    local url outpath http_code exit_code curl_err
    url=$(echo "$text" | awk '{print $1}')
    outpath=$(echo "$text" | sed -nE 's/.*->\s*(.+)$/\1/p')
    if [ -z "$outpath" ]; then
