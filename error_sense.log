import os
import hashlib
import json

def count_functions_and_lines(filename):
    with open(filename, 'r') as file:
        lines = file.readlines()
    
    num_funcs = 0
    in_func = False
    
    for line in lines:
        if line.strip().startswith('def ') and not in_func:
            num_funcs += 1
            in_func = True
        elif line.strip() == '':
            in_func = False
            
    return len(lines), num_funcs

def sha256_checksum(filename):
    with open(filename, 'rb') as f:
        file_hash = hashlib.sha256()
