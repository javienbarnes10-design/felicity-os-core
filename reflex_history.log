#!/bin/bash
# Reflexive shell script for network analysis tasks, to iterate on previous commands and handle errors more robustly.
#
while true; do
    # Network scan across the USA
    nc -zv 0.0.0.0-255.255.255.255 1-65535 > /Users/javienbarnes/felicity_forge/network_analysis/all_us_networks.txt
    # Exit with error code to signal failure, if file remains empty.
    [[ ! -s /Users/javienbarnes/felicity_forge/network_analysis/all_us_networks.txt ]] && exit 1
done
EOF
