[2026-08-09 22:50:00] COMMAND: cat > /tmp/system_health_check.py <<EOF
import os
import sqlite3

# Define the path to the SQLite database file
db_path = '/Users/javienbarnes/felicity_forge/sovereign.db'

def update_system_health():
    try:
        # Connect to the SQLite database and create a cursor object
        conn = sqlite3.connect(db_path)
        c = conn.cursor()
        
        # Define SQL query for inserting data into system_health table
        sql_insert_query = '''
            INSERT INTO system_health (timestamp, cpu_usage, memory_usage, disk_usage, network_latency) 
            VALUES (?, ?, ?, ?, ?);
        '''

        # Collect the necessary metrics using shell commands
        timestamp = os.popen('date \"+%Y-%m-%d %H:%M:%S\"').read().strip()
        cpu_usage = float(os.popen('top -l 1 | grep "CPU usage:" | awk \'{print \$3}\'').read().strip())
        memory_usage = float(os.popen('top -l 1 | grep PhysMem: | awk \'{print \$4}\'').read().strip())
        disk_usage_gb = int(float(os.popen('df /Users/javienbarnes/felicity_forge | tail -1 | awk \'{print \$2/1024/1024}\'').read().strip()))
        network_latency_ms = float(os.popen('ping -c 1 google.com | grep rtt | awk \'{print \$4}\'').read().strip())

        # Execute the SQL query to insert data into the table
        c.execute(sql_insert_query, (timestamp, cpu_usage, memory_usage, disk_usage_gb, network_latency_ms))
        
        # Commit changes and close the connection
        conn.commit()
        conn.close()

    except Exception as e:
        with open('/Users/javienbarnes/felicity_forge/error_sense.log', 'a') as f:
            f.write(f'ERROR in system health insert: {e}\n')

update_system_health()
EOF
