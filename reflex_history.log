import sqlite3
import json
from datetime import datetime, timedelta

def convert_timestamp(timestamp):
    return datetime.strptime(timestamp, "%Y-%m-%d %H:%M:%S")

def main():
    db_conn = sqlite3.connect('/Users/javienbarnes/felicity_forge/sovereign.db')
    db_cursor = db_conn.cursor()

    db_cursor.execute('SELECT timestamp, command, exit_code FROM reflex_history')
    db_records = db_cursor.fetchall()

    error_entries = []
    with open('/Users/javienbarnes/felicity_forge/error_sense.log', 'r') as error_file:
        for line in error_file:
            error_entries.append(line.strip())

    with open('/Users/javienbarnes/felicity_forge/error_patterns.log', 'r') as pattern_file:
        for line in pattern_file:
            error_entries.append(line.strip())

    discrepancy_entries = []
    for db_record in db_records:
        db_timestamp = convert_timestamp(db_record[0])
        db_exit_code = db_record[2]

        if db_exit_code == 0:
            for error_entry in error_entries:
                if abs((convert_timestamp(error_entry.split(' ')[0]) - db_timestamp).total_seconds()) <= 5:
                    discrepancy_entries.append((db_record[0], db_record[1], 1))
                    break

    for entry in discrepancy_entries:
        db_cursor.execute('UPDATE reflex_history SET exit_code = ? WHERE timestamp = ?', (1, entry[0]))

    db_conn.commit()
    db_conn.close()

    with open('/Users/javienbarnes/felicity_forge/system_audit/discrepancy_report.json', 'w') as report_file:
        json.dump({'discrepancy_entries': discrepancy_entries}, report_file)

if __name__ == "__main__":
    main()
