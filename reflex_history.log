import json
import sqlite3
from datetime import datetime
from glob import glob

def convert_timestamp(timestamp_str):
    return datetime.strptime(timestamp_str, "%Y-%m-%d %H:%M:%S")

def main():
    # Connect to the database
    conn = sqlite3.connect('/Users/javienbarnes/felicity_forge/sovereign.db')
    c = conn.cursor()

    # Retrieve exit_code = 0 entries from reflex_history
    c.execute("SELECT * FROM reflex_history WHERE exit_code = 0")
    exit_zero_entries = c.fetchall()

    # Gather timestamp and error message pairs from error logs
    error_files = glob('/Users/javienbarnes/felicity_forge/*.log')
    error_entries = []
    for error_file in error_files:
        with open(error_file, 'r') as f:
            error_entries.extend(f.readlines())

    findings = []
    for entry in exit_zero_entries:
        entry_timestamp = entry[0]
        db_timestamp = convert_timestamp(entry_timestamp)
        for error_entry in error_entries:
            if abs((convert_timestamp(error_entry.split(' ')[0]) - db_timestamp).total_seconds()) <= 5:
                findings.append({
                    'timestamp': entry_timestamp,
                    'command': entry[1],
                    'exit_code': 1,
                    'log_message': error_entry.strip()
                })

    # Update false zero exit codes to 1 in the database
    for finding in findings:
        c.execute("UPDATE reflex_history SET exit_code = 1 WHERE timestamp = ?", (finding['timestamp'],))

    # Commit changes to the database
    conn.commit()

    # Generate the final findings report
    report_path = '/Users/javienbarnes/felicity_forge/system_audit/discrepancy_report.json'
    with open(report_path, 'w') as report_file:
        json.dump(findings, report_file)

    # Close the database connection
    conn.close()

if __name__ == "__main__":
    main()
